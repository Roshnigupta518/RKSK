     fun setWebviewDebuggingEnabled(viewWrapper: RNCWebViewWrapper, enabled: Boolean) {
+        // F-26 hardening: the setWebContentsDebuggingEnabled() call is a static
+        // method on android.webkit.WebView — invoking it with `true` enables
+        // chrome://inspect debugging for EVERY WebView in the process for the
+        // entire process lifetime. In release builds we ignore the JS prop
+        // entirely; a rogue or accidentally-shipped <WebView webviewDebuggingEnabled />
+        // must never be able to flip the process-wide flag on a customer's device.
+        // Debug builds retain the original behaviour so dev-loop tooling still works.
+        if (!BuildConfig.DEBUG) {
+            return
+        }
         RNCWebView.setWebContentsDebuggingEnabled(enabled)
     }
 
